# Dani-Free standard listener: OpenCode + Kilo adapters
# (`dani-free start` advertises three OpenCode free ids then three Kilo free ids;
#  the Kilo-only variant is `bun run src/kilo-only.ts`, default port 4290)
DANI_FREE_HOST=127.0.0.1
DANI_FREE_PORT=4190

# Optional key required by clients of the local router.
# Generate a local value; never commit a real credential.
DANI_FREE_API_KEY=

# Optional JSON config file path. Settings resolve: defaults, then this JSON file,
# then DANI_FREE_* environment variables (env wins). Defaults to
# ~/.config/dani-free/config.json when it exists; a missing file is only an error
# when this variable names it explicitly. Accepts flat keys host, port, apiKey,
# requestTimeoutMs, bodyLimitBytes, plus one object per backend (opencode, kilo,
# mimo — or nested under "backends") with baseUrl, apiKey, command, timeoutMs.
# DANI_FREE_CONFIG=

# Kilo Code — advertised model: kilo/nex-agi/nex-n2.5-pro:free
DANI_FREE_KILO_BASE_URL=
DANI_FREE_KILO_API_KEY=

# OpenCode — genuine local `opencode serve` sidecar (session API, NOT OpenAI-compatible).
# OpenCode's free tier only works from inside the genuine OpenCode client, so this
# adapter only talks to the local sidecar and never to https://opencode.ai/zen/v1.
# Start it with: OPENCODE_SERVER_PASSWORD=$(openssl rand -hex 32) opencode serve --port 4187 --hostname 127.0.0.1
DANI_FREE_OPENCODE_BASE_URL=http://127.0.0.1:4187
# Sidecar password, when set. Sent as HTTP Basic `opencode:<key>` on every request.
# DANI_FREE_OPENCODE_API_KEY=

# Single request deadline in milliseconds (standard listener default 180000;
# Kilo-only listener default 120000 when it falls back). Must be an integer
# between 100 and 300000; a typo is rejected at startup, never NaN.
# DANI_FREE_REQUEST_TIMEOUT_MS=180000
