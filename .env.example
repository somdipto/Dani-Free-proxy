# Dani-Free listener (`dani-free start` starts Kilo only; not MiMo or OpenCode)
DANI_FREE_HOST=127.0.0.1
DANI_FREE_PORT=4190

# Optional key required by clients of the local router.
# Generate a local value; never commit a real credential.
DANI_FREE_API_KEY=

# Kilo Code — advertised model: kilo/nex-agi/nex-n2.5-pro:free
DANI_FREE_KILO_BASE_URL=
DANI_FREE_KILO_API_KEY=

# OpenCode — genuine local `opencode serve` sidecar (session API, NOT OpenAI-compatible).
# OpenCode's free tier only works from inside the genuine OpenCode client, so this
# adapter only talks to the local sidecar and never to https://opencode.ai/zen/v1.
# Start it with: OPENCODE_SERVER_PASSWORD=$(openssl rand -hex 32) opencode serve --port 4187 --hostname 127.0.0.1
DANI_FREE_OPENCODE_BASE_URL=http://127.0.0.1:4187
# Sidecar password, when set. Sent as HTTP Basic `opencode:<key>` on every request.
# DANI_FREE_OPENCODE_API_KEY=
