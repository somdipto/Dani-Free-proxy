# Standard listener. `auto` targets OpenCode slot 1; OpenCode models appear only when
# this is a provider-authorized, OpenAI Chat Completions-compatible endpoint.
DANI_FREE_HOST=127.0.0.1
DANI_FREE_PORT=4190

# Optional key required by clients of the local router.
# Generate a local value; never commit a real credential.
DANI_FREE_API_KEY=

# OpenCode. Configuration does not grant free-tier authorization.
DANI_FREE_OPENCODE_BASE_URL=
DANI_FREE_OPENCODE_API_KEY=

# Kilo Code slots 4-6.
DANI_FREE_KILO_BASE_URL=
DANI_FREE_KILO_API_KEY=
